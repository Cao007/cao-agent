# demo: 本地验证链路，不调用模型；openai: 使用真实的 OpenAI 兼容接口。
MODEL_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=60
APP_NAME=Cao AI
POSTGRES_PASSWORD=cao
DATABASE_URL=postgresql://cao:cao@localhost:5432/cao
COOKIE_SECURE=false
SESSION_HOURS=24
ALLOW_REGISTRATION=true
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
NPM_REGISTRY=https://registry.npmmirror.com
# LangSmith 追踪为可选项，使用 shell 环境变量开启（见 README）。
# 本文件由 Pydantic Settings 读取，额外的 LangSmith 字段不会导入进程环境。
